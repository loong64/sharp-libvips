diff --git a/platforms/linux-loong64/Dockerfile b/platforms/linux-loong64/Dockerfile
new file mode 100644
index 0000000..fa4ffcb
--- /dev/null
+++ b/platforms/linux-loong64/Dockerfile
@@ -0,0 +1,62 @@
+FROM debian:trixie
+LABEL maintainer="Lovell Fuller <npm@lovell.info>"
+
+## Copyright 2017 Lovell Fuller and others.
+## SPDX-License-Identifier: Apache-2.0
+
+# Create Debian 13 (glibc 2.41) container suitable for cross-compiling Linux LoongArch 64-bit binaries
+
+# Path settings
+ENV \
+  RUSTUP_HOME="/usr/local/rustup" \
+  CARGO_HOME="/usr/local/cargo" \
+  PATH="/usr/local/cargo/bin:/root/.local/bin:$PATH"
+
+COPY trixie-loong64.sources /etc/apt/sources.list.d/trixie-loong64.sources
+RUN \
+  dpkg --add-architecture loong64 && \
+  apt-get update -o Acquire::AllowInsecureRepositories=true && \
+  apt-get install -y --allow-unauthenticated curl debian-loong64-non-official-archive-keyring && \
+  sed -i 's/# Signed-By/Signed-By/g' /etc/apt/sources.list.d/trixie-loong64.sources
+
+# Build dependencies
+RUN \
+  apt-get update && \
+  apt-get install -y \
+    autoconf \
+    autopoint \
+    cmake \
+    g++-loongarch64-linux-gnu \
+    gettext \
+    git \
+    gperf \
+    jq \
+    libcurl4-openssl-dev \
+    libssl-dev \
+    libtool \
+    ninja-build \
+    pipx \
+    pkgconf \
+    pkgconf:loong64 \
+    && \
+  curl https://sh.rustup.rs -sSf | sh -s -- -y \
+    --no-modify-path \
+    --profile minimal \
+    --target loongarch64-unknown-linux-gnu \
+    --default-toolchain nightly \
+    && \
+  cargo install cargo-c --locked && \
+  pipx install meson
+
+# Compiler settings
+ENV \
+  PKG_CONFIG="loongarch64-linux-gnu-pkg-config --static" \
+  PLATFORM="linux-loong64" \
+  CHOST="loongarch64-linux-gnu" \
+  RUST_TARGET="loongarch64-unknown-linux-gnu" \
+  FLAGS="" \
+  RUSTFLAGS="-Zlocation-detail=none -Zfmt-debug=none" \
+  MESON="--cross-file=/root/meson.ini"
+
+COPY Toolchain.cmake /root/
+COPY meson.ini /root/
diff --git a/platforms/linux-loong64/Toolchain.cmake b/platforms/linux-loong64/Toolchain.cmake
new file mode 100644
index 0000000..7d50db5
--- /dev/null
+++ b/platforms/linux-loong64/Toolchain.cmake
@@ -0,0 +1,15 @@
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_VERSION 1)
+set(CMAKE_SYSTEM_PROCESSOR loongarch64)
+
+SET(CMAKE_C_COMPILER loongarch64-linux-gnu-gcc)
+SET(CMAKE_CXX_COMPILER loongarch64-linux-gnu-g++)
+SET(CMAKE_AR loongarch64-linux-gnu-gcc-ar)
+SET(CMAKE_STRIP loongarch64-linux-gnu-gcc-strip)
+SET(CMAKE_RANLIB loongarch64-linux-gnu-gcc-ranlib)
+
+set(CMAKE_FIND_ROOT_PATH $ENV{TARGET_SYSROOT})
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
diff --git a/platforms/linux-loong64/meson.ini b/platforms/linux-loong64/meson.ini
new file mode 100644
index 0000000..81df8f1
--- /dev/null
+++ b/platforms/linux-loong64/meson.ini
@@ -0,0 +1,28 @@
+[host_machine]
+system = 'linux'
+cpu_family = 'loongarch64'
+cpu = 'loongarch64'
+endian = 'little'
+
+[binaries]
+c = 'loongarch64-linux-gnu-gcc'
+cpp = 'loongarch64-linux-gnu-g++'
+ar = 'loongarch64-linux-gnu-gcc-ar'
+nm = 'loongarch64-linux-gnu-gcc-nm'
+ld = 'loongarch64-linux-gnu-gcc-ld'
+strip = 'loongarch64-linux-gnu-strip'
+ranlib = 'loongarch64-linux-gnu-gcc-ranlib'
+
+[properties]
+# https://docs.gtk.org/glib/cross-compiling.html#cross-properties
+have_c99_vsnprintf = true
+have_c99_snprintf = true
+have_unix98_printf = true
+
+[built-in options]
+libdir = 'lib'
+datadir = '/usr/share'
+localedir = '/usr/share/locale'
+sysconfdir = '/etc'
+localstatedir = '/var'
+wrap_mode = 'nofallback'
